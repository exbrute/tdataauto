# Токен Telegram-бота (@BotFather)
BOT_TOKEN=

# my.telegram.org — нужны для Telethon (opentele подставит официальный API, но ID/HASH лучше указать свои)
API_ID=
API_HASH=

# Ссылка на пост канала, куда отправлять звёзды (платные реакции)
# Пример: https://t.me/your_channel/123 или https://t.me/c/1234567890/123
CHANNEL_POST_URL=

# Режим продажи подарков: convert | resell | both
SELL_MODE=both

# Цена перепродажи NFT-подарков (0 = минимальная по правилам Telegram)
RESELL_PRICE=0

# Сколько звёзд оставить на балансе аккаунта
KEEP_STARS=0

# Максимум звёзд за один вызов платной реакции (лимит Telegram)
MAX_PAID_REACTION_BATCH=2500

# Папка для входящих tdata (CLI) и временных файлов бота
DATA_DIR=./data
